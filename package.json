{
  "name": "profjero-edupro",
  "version": "0.1.0",
  "description": "ProfJero Edu / EduPro — digital learning ecosystem by ProfJero Digital Studio",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-worker.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "playwright test --trace off",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,supavisor,edge-runtime,storage-api",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "deploy": "node scripts/deploy-pages.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProfJero/ProfJero-EduPro.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/ProfJero/ProfJero-EduPro/issues"
  },
  "homepage": "https://github.com/ProfJero/ProfJero-EduPro#readme",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "monaco-editor": "^0.55.1",
    "pg": "^8.23.1",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@hookform/resolvers": "^7.0.7",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@supabase/supabase-js": "^2.119.1",
    "@tanstack/react-query": "^5.108.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "emmet-monaco-es": "^5.7.0",
    "lucide-react": "^1.76.0",
    "papaparse": "^5.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^6.30.6",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "private": true,
  "type": "module"
}
