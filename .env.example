# ---- Frontend (public, safe to expose) ---------------------------------------
# Supabase project URL and publishable (anon) key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
# Cloudinary cloud name (public). Leave empty to disable uploads in the UI.
VITE_CLOUDINARY_CLOUD_NAME=
# Base URL of the server API (Cloudflare Pages Functions). Empty = same origin.
VITE_API_BASE=

# ---- Server-side secrets (set as Cloudflare Pages secrets, NEVER as VITE_*) --
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_ANON_KEY=your-publishable-anon-key
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
